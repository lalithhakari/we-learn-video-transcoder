14, 2102, 12310, 30, 51264], "temperature": 0.0, "avg_logprob": -0.1539445718129476, "compression_ratio": 1.6708860759493671, "no_speech_prob": 0.01022326573729515}, {"id": 52, "seek": 14448, "start": 162.48, "end": 165.95999999999998, "text": " So, we'll be spending most of our time on the command line, but when it makes sense", "tokens": [51264, 407, 11, 321, 603, 312, 6434, 881, 295, 527, 565, 322, 264, 5622, 1622, 11, 457, 562, 309, 1669, 2020, 51438], "temperature": 0.0, "avg_logprob": -0.1539445718129476, "compression_ratio": 1.6708860759493671, "no_speech_prob": 0.01022326573729515}, {"id": 53, "seek": 14448, "start": 165.95999999999998, "end": 170.64, "text": " to use a GUI tool, I'll be showing you examples in VS Code and Git Kraken because those are", "tokens": [51438, 281, 764, 257, 17917, 40, 2290, 11, 286, 603, 312, 4099, 291, 5110, 294, 25091, 15549, 293, 16939, 26988, 2653, 570, 729, 366, 51672], "temperature": 0.0, "avg_logprob": -0.1539445718129476, "compression_ratio": 1.6708860759493671, "no_speech_prob": 0.01022326573729515}, {"id": 54, "seek": 14448, "start": 170.64, "end": 172.16, "text": " the most popular tools.", "tokens": [51672, 264, 881, 3743, 3873, 13, 51748], "temperature": 0.0, "avg_logprob": -0.1539445718129476, "compression_ratio": 1.6708860759493671, "no_speech_prob": 0.01022326573729515}, {"id": 55, "seek": 17216, "start": 172.16, "end": 175.12, "text": " Now, if you have never worked with a command line before, don't worry.", "tokens": [50364, 823, 11, 498, 291, 362, 1128, 2732, 365, 257, 5622, 1622, 949, 11, 500, 380, 3292, 13, 50512], "temperature": 0.0, "avg_logprob": -0.19599378903706868, "compression_ratio": 1.3933333333333333, "no_speech_prob": 0.00319599243812263}, {"id": 56, "seek": 17216, "start": 175.12, "end": 178.64, "text": " I'm going to hold your hands and teach you everything step by step.", "tokens": [50512, 286, 478, 516, 281, 1797, 428, 2377, 293, 2924, 291, 1203, 1823, 538, 1823, 13, 50688], "temperature": 0.0,